# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Recipe Extraction Service
EXPO_PUBLIC_RECIPE_EXTRACTION_SERVICE_URL=https://recipeextractionservice.onrender.com

# DeepSeek API Configuration 
EXPO_PUBLIC_DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Google Vision API Configuration for OCR
EXPO_PUBLIC_GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# RevenueCat Configuration
# Get these from https://app.revenuecat.com/projects
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=your_revenuecat_ios_key_here
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=your_revenuecat_android_key_here

# The fallback key is configured in constants/api.ts if needed

# App Version (optional)
EXPO_PUBLIC_APP_VERSION=1.0.0 