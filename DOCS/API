## Example Usage

```javascript
import { extractRecipe, scrapeWebContent } from "../services/recipeService";

const RecipeScreen = () => {
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);
  const [content, setContent] = useState(null);

  const handleExtractContent = async (url) => {
    try {
      setLoading(true);
      setError(null);

      // Determine if it's Instagram or general web content
      if (url.includes("instagram.com")) {
        const data = await extractRecipe(url);
        setContent(data);
      } else {
        // Use real web scraping instead of fake content
        const data = await scrapeWebContent(url, {
          text: true,
          metadata: true,
          images: true,
          headings: true,
        });
        setContent(data);
      }
    } catch (err) {
      setError(err.message);
    } finally {
      setLoading(false);
    }
  };

  // ... rest of the component
};
```

