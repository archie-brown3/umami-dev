# Server Configuration
NODE_ENV=development
PORT=3000

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Configuration (for additional security if needed)
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=7d

# External APIs
DEEPSEEK_API_KEY=your-deepseek-api-key
RECIPE_EXTRACTION_SERVICE_URL=https://recipeextractionservice.onrender.com

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,https://your-flutter-app.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Test User Credentials (for API testing)
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=your-test-password

