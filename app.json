{
  "expo": {
    "name": "umami-dev",
    "slug": "umami-dev",
    "version": "2.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "umami-dev",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.recipesaver.app",
      "buildNumber": "11",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "We need access to your camera to let you take photos of your recipes and meals",
        "NSPhotoLibraryUsageDescription": "We need access to your photo library to let you select photos of your recipes and meals",
        "NSPhotoLibraryAddUsageDescription": "We need access to your photo library to save photos of your recipes and meals"
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "io.recipesaver.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": false
        }
      ],
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "platforms": ["ios", "android"],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8c925526-896e-49cf-8e9d-60f6540d4a20"
      }
    },
    "owner": "mightyarch",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
